{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@s:ui/*": [
        "./ui/static/ui/*"
      ],
      "@t:ui/*": [
        "./ui/templates/ui/*"
      ]
    }
  },
  "include": ["ui/static/**/*", "ui/templates/**/*"]
}
