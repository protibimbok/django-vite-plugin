{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@s:blog/*": [
        "./blog/static/blog/*"
      ],
      "@t:blog/*": [
        "./blog/templates/blog/*"
      ],
      "@s:dashboard/*": [
        "./dashboard/static/dashboard/*"
      ],
      "@t:dashboard/*": [
        "./dashboard/templates/dashboard/*"
      ]
    }
  },
  "include": ["blog/static/**/*", "dashboard/static/**/*", "static/**/*"],
  "exclude": ["node_modules"]
}
